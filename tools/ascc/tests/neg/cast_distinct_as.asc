// `as` must not touch distinct types: construct/unwrap explicitly instead
// (Paddr(x) / u64(p)). Direct casting would silently erase the type distinction
// the whole kernel address discipline rests on.
type Paddr = distinct u64;

fn kmain() -> never {
    let p: Paddr = Paddr(0x1000);
    let v = p as u64;
}
