// break/continue inside while, plus nesting: the inner `break` must leave the
// inner loop only, and `continue` must re-test the condition rather than fall
// through the body tail.

fn scan_find_first(base: *const u8, len: u64) -> u64 {
    let mut_i: u64 = 0;
    while mut_i < len {
        if base[mut_i] == 0x7B {   // '{'
            break;
        }
        mut_i = mut_i + 1;
    }
    return mut_i;
}

fn count_even_sums() -> u64 {
    let mut_total: u64 = 0;
    let mut_i: u64 = 0;
    while mut_i < 100 {
        mut_i = mut_i + 1;
        if mut_i % 2 == 1 {
            continue;
        }
        mut_total = mut_total + mut_i;
    }
    return mut_total;
}

fn nested_break_hits_inner_only() -> u64 {
    let mut_hits: u64 = 0;
    let mut_outer: u64 = 0;
    while mut_outer < 3 {
        let mut_inner: u64 = 0;
        while mut_inner < 5 {
            mut_inner = mut_inner + 1;
            if mut_inner == 2 {
                break;
            }
            mut_hits = mut_hits + 1;
        }
        mut_outer = mut_outer + 1;
    }
    return mut_hits;
}

fn break_in_if_body() -> u64 {
    let mut_n: u64 = 0;
    while true {
        mut_n = mut_n + 1;
        if mut_n > 4 {
            break;
        } else {
            mut_n = mut_n + 0;
        }
    }
    return mut_n;
}
