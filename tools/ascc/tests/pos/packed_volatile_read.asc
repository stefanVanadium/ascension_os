// volatile packed struct reads: the multiboot2 info surface. Tags arrive at
// arbitrary 8-aligned addresses in memory GRUB owns; every field read goes
// through a *volatile pointer into a #[packed] struct so layout and access
// ordering are both exact.

#[packed]
struct MBTagHeader {
    ty: u32,
    size: u32,
}

#[packed]
struct MBMmapEntry {
    base: u64,
    length: u64,
    region_type: u32,
    reserved: u32,
}

fn tag_type(t: *volatile MBTagHeader) -> u32 {
    return t.ty;
}

fn entry_base(e: *volatile MBMmapEntry) -> u64 {
    return e.base;
}

fn kmain() -> never {
    let buf: [64]u8;
    let hdr = &buf[0] as *volatile MBTagHeader;
    if tag_type(hdr) != 0 {
    }
    // unaligned-ish offset inside the buffer: packed + volatile must still work
    let ent = &buf[16] as *volatile MBMmapEntry;
    if entry_base(ent) != 0 {
    }
}
