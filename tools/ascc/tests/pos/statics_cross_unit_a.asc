// Two units sharing static state through an accessor fn, not a data symbol:
// the counter lives in unit B (internal linkage); unit A sees it only via
// exported functions. Mirrors isr.asc -> pit.asc tick-counter flow.
// EXPECT-UNDEF: ticks_bump

let local_scratch: u64;

fn ticks_bump() -> u64;   // defined in unit B against ITS static

fn exercise() -> bool {
    local_scratch = 7;
    if ticks_bump() != 1 {
        return false;
    }
    return true;
}

fn kmain() -> never {
    let ok = exercise();
}
