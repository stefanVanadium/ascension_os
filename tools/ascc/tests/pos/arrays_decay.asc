// arrays: indexed load/store, implicit decay on call, explicit decay cast
fn consume(p: *const u8) -> u8 {
    return p[0];
}
fn fill(buf: *u8, n: u64) {
    let i: u64 = 0;
    while i < n {
        buf[i] = 'A';
        i = i + 1;
    }
}
const N: u64 = 16;
fn kmain() -> never {
    let buf: [N]u8;
    let i: u64 = 0;
    while i < N {
        buf[i] = i as u8;
        i = i + 1;
    }
    fill(buf, N);
    if consume(buf) != 'x' {
        panic("decay failed");
    }
    let p: *u8 = buf as *u8;
    p[1] = '!';
    halt();
}
fn panic(msg: *const u8) -> never {
    halt();
}
fn halt() -> never;
