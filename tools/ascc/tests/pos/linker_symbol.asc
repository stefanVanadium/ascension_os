// Linker-script symbols from Asc: PMM needs `kernel_end` (defined in
// linker.ld, owned by no object). Inline asm references it; ld resolves the
// undefined symbol at link time. The AT&T bracket form (`lea %0, [rip+sym]`)
// does NOT parse under LLVM's integrated assembler; the displacement form
// below does.
fn kernel_end_phys() -> u64 {
    let ret: u64;
    asm { "leaq kernel_end(%rip), %0" : "=r"(ret) }
    return ret;
}

fn kmain() -> never {
    let e = kernel_end_phys();
}
// EXPECT-UNDEF: kernel_end
