// #[packed] structs: hardware layout with no padding. LLVM spells packed
// struct types <{ ... }>; the GDTR/IDTR class of structs depends on it.

#[packed]
struct GDTR {
    limit: u16,
    base: u64,
}

fn base_of(g: *const GDTR) -> u64 {
    return g.base;
}

fn kmain() -> never {
    let t: GDTR;
}
