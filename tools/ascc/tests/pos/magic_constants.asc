// __FILE__ expands to the source path string, __LINE__ to the line number
fn note(f: *const u8, l: u64) -> u64 {
    touch(f);
    return l;
}
fn touch(p: *const u8) -> void;
fn kmain() -> never {
    // __LINE__ below must be exactly 10
    if note(__FILE__, __LINE__) != 10 {
        halt();
    }
    halt();
}
fn halt() -> never;
