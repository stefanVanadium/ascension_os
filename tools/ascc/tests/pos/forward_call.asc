// Same-unit use-before-definition: a forward call emits a declaration; the
// later definition must REUSE that symbol, not add a second function (LLVM
// would rename it `callee.1` and the link would fail).
// EXPECT-DEF: callee

fn caller(x: u64) -> u64 {
    return callee(x);
}

fn callee(x: u64) -> u64 {
    return x + 1;
}

fn kmain() -> never {
    let r = caller(41);
}
