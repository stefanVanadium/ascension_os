// Module-level statics: zero-initialized, unit-private runtime storage.
// The pattern every arch table and counter uses: static state + accessor fns.

const TABLE_LEN: u64 = 4;

let counter: u64;
let gates: [TABLE_LEN]u64;

fn bump() -> u64 {
    counter = counter + 1;
    return counter;
}

fn gate_set(i: u64, v: u64) {
    gates[i] = v;
}

fn gate_get(i: u64) -> u64 {
    return gates[i];
}

// address-of a static: flush-style APIs take pointers to module tables
fn slot_ptr() -> *u64 {
    return &gates[0];
}

fn read_through(p: *const u64) -> u64 {
    return p[0];
}

fn exercise() -> bool {
    if bump() != 1 {
        return false;
    }
    if counter != 1 {
        return false;
    }
    gate_set(0, 42);
    if gate_get(0) != 42 {
        return false;
    }
    let p = slot_ptr();
    if read_through(p) != 42 {
        return false;
    }
    return true;
}

fn kmain() -> never {
    let ok = exercise();
}
