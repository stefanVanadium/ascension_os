// int <-> pointer `as` casts: the page-table walking surface. VMM turns PTE
// values into table pointers and back; distinct types stay out of `as` by
// design (unwrap first, then cast).

const PHYS_MEM_BASE: u64 = 0xFFFF800000000000;

type Paddr = distinct u64;
type Vaddr = distinct u64;

fn phys_to_virt(p: Paddr) -> Vaddr {
    return Vaddr(u64(p) + PHYS_MEM_BASE);
}

fn virt_to_phys(v: Vaddr) -> Paddr {
    return Paddr(u64(v) - PHYS_MEM_BASE);
}

fn kmain() -> never {
    // u64 -> pointer: synthesize an address, cast, read nothing (bogus addr)
    let a: u64 = 0x1000;
    let p = a as *u64;

    // pointer -> u64: the round trip must be identity
    let b = p as u64;
    if b != a {
        // unreachable by construction; the check forces both casts to codegen
    }

    // const -> pointer and back
    let q = 4096 as *const u8;
    if q as u64 != 4096 {
    }

    // distinct unwrap THEN int->ptr cast: the only sanctioned path.
    // `phys_to_virt(frame) as *T` would be rejected: distinct never touches as.
    let frame: Paddr = Paddr(0x200000);
    let tp = u64(phys_to_virt(frame)) as *volatile u64;
    let back = virt_to_phys(Vaddr(tp as u64));
    if u64(back) != 0x200000 {
    }
}
