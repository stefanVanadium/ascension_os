// &: address of local and struct; pointer-to-struct field auto-deref (load+store)
struct Point { x: u64, y: u64 }
struct Pair { a: Point, b: Point }

fn bump(p: *Point) -> u64 {
    p.x = p.x + 1;
    return p.x;
}

fn kmain() -> never {
    let v: u64 = 5;
    let pv: *u64 = &v;
    pv[0] = 6;

    let pt: Point;
    pt.x = 7;
    pt.y = bump(&pt);

    let pr: Pair;
    pr.a.x = 1;
    pr.b.y = pt.y;

    let pp: *Point = &pr.b;
    pp.y = 9;

    if pr.b.y != 9 {
        fail();
    }
    halt();
}
fn halt() -> never;
fn fail() -> never;
