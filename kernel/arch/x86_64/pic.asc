// kernel/arch/x86_64/pic.asc: legacy 8259A cascade setup.
//
// Remapped away from vectors 8..15 (the BIOS default lands ON TOP of CPU
// exceptions) to 32..47. Only IRQ0 is unmasked: the PIT is the sole
// consumer this sprint, and a masked slave kills the whole spurious-IRQ
// class before it can happen.

fn outb(port: u16, val: u8) -> void;

const PIC_MASTER_CMD: u16 = 0x20;
const PIC_MASTER_DATA: u16 = 0x21;
const PIC_SLAVE_CMD: u16 = 0xA0;
const PIC_SLAVE_DATA: u16 = 0xA1;

const PIC_ICW1_INIT: u8 = 0x11;       // init + cascade + ICW4 needed
const PIC_ICW2_MASTER_BASE: u8 = 0x20; // IRQ0..7 -> vectors 32..39
const PIC_ICW2_SLAVE_BASE: u8 = 0x28;  // IRQ8..15 -> vectors 40..47
const PIC_ICW3_MASTER_IR2: u8 = 0x04;  // slave hangs off IR2
const PIC_ICW3_SLAVE_ID: u8 = 0x02;    // slave's cascade identity
const PIC_ICW4_8086: u8 = 0x01;        // 8086 mode

const PIC_OCW1_ALL_MASKED: u8 = 0xFF;
const PIC_OCW1_IRQ0_ONLY: u8 = 0xFE;
const PIC_EOI_GENERIC: u8 = 0x20;
const PIC_VECTOR_SLAVE_BASE: u64 = 40; // vectors from here live on the slave

fn pic_remap() -> void {
    outb(PIC_MASTER_CMD, PIC_ICW1_INIT);
    outb(PIC_SLAVE_CMD, PIC_ICW1_INIT);
    outb(PIC_MASTER_DATA, PIC_ICW2_MASTER_BASE);
    outb(PIC_SLAVE_DATA, PIC_ICW2_SLAVE_BASE);
    outb(PIC_MASTER_DATA, PIC_ICW3_MASTER_IR2);
    outb(PIC_SLAVE_DATA, PIC_ICW3_SLAVE_ID);
    outb(PIC_MASTER_DATA, PIC_ICW4_8086);
    outb(PIC_SLAVE_DATA, PIC_ICW4_8086);
}

fn pic_mask_irq0_only() -> void {
    outb(PIC_SLAVE_DATA, PIC_OCW1_ALL_MASKED);
    outb(PIC_MASTER_DATA, PIC_OCW1_IRQ0_ONLY);
}

fn pic_send_eoi(vector: u64) -> void {
    if vector >= PIC_VECTOR_SLAVE_BASE {
        outb(PIC_SLAVE_CMD, PIC_EOI_GENERIC);
    }
    outb(PIC_MASTER_CMD, PIC_EOI_GENERIC);
}
