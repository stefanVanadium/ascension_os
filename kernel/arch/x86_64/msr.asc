// kernel/arch/x86_64/msr.asc: model-specific register access.
//
// rdmsr/wrmsr split values across edx:eax. The v0 inline-asm surface allows
// at most ONE output per block, so rdmsr recovers both halves through a
// pinned pointer input instead of two register outputs; wrmsr is pure inputs
// already. Callers never see the halves.

const U32_MASK: u64 = 0xFFFFFFFF;

fn rdmsr(msr: u32) -> u64 {
    let halves: [2]u32;
    // eax and edx are outputs of rdmsr and of nothing else here, so they have
    // to be declared clobbered: without the list LLVM may keep a live value in
    // either register across the block, and may allocate the halves pointer
    // itself to eax or edx, which would store the low half to address 0.
    asm { "rdmsr; movl %eax, (%0); movl %edx, 4(%0)"
          :: "r"(&halves[0]), "c"(msr) : "eax", "edx", "memory" }
    return ((halves[1] as u64) << 32) | (halves[0] as u64);
}

fn wrmsr(msr: u32, val: u64) -> void {
    let lo = (val & U32_MASK) as u32;
    let hi = (val >> 32) as u32;
    asm { "wrmsr" :: "a"(lo), "d"(hi), "c"(msr) : "memory" }
}
