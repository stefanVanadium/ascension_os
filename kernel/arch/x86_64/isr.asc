// kernel/arch/x86_64/isr.asc: Asc side of the interrupt ABI.
//
// isr_stubs.asm builds the frame bottom-up: 15 saved GPRs, vector, error
// code, then the CPU's iretq block; RDI carries the frame pointer in here.
// The struct below mirrors those 22 qwords exactly (all-u64 fields, so
// struct packing is moot). Exceptions halt instead of iretq-ing back into
// the context that faulted; IRQ paths acknowledge through the PIC, with
// the spurious master vector deliberately left unacknowledged.

fn panic_puts(msg: *const u8) -> void;
fn panic_putc(c: u8) -> void;
fn panic_puthex(v: u64) -> void;
fn pit_tick() -> void;
fn pic_send_eoi(vector: u64) -> void;

struct ISRFrame {
    r15: u64, r14: u64, r13: u64, r12: u64, r11: u64, r10: u64,
    r9: u64, r8: u64,
    rbp: u64, rdi: u64, rsi: u64, rdx: u64, rcx: u64, rbx: u64, rax: u64,
    vector: u64, errcode: u64,
    rip: u64, cs: u64, rflags: u64, rsp: u64, ss: u64,
}

const VECTOR_EXCEPTION_MAX: u64 = 32;   // 0..31 are CPU exceptions
const VECTOR_PIT: u64 = 32;             // PIC remap puts IRQ0 at 32
const VECTOR_SPURIOUS_MASTER: u64 = 39; // spurious IRQ7 shows up as this
const VECTOR_IRQ_MAX: u64 = 48;         // 32..47 is the cascaded PIC range

const DEC_DIGITS: u64 = 20;             // ceil(log10(2^64)) digits + slack

fn dump_reg(label: *const u8, v: u64) -> void {
    panic_puts(label);
    panic_puthex(v);
    panic_putc('\n');
}

// local copy of the decimal walker: units cannot share fns until modules
// land, and kernel.asc's serial printer must not become a core->arch dep
fn isr_print_dec(v: u64) -> void {
    let digits: [DEC_DIGITS]u8;
    let count: u64 = 0;
    let rem = v;
    if rem == 0 {
        panic_putc('0');
        return;
    }
    while rem > 0 {
        digits[count] = '0' + (rem % 10) as u8;
        rem = rem / 10;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        panic_putc(digits[count]);
    }
}

fn exception_halt(frame: *const ISRFrame) -> never {
    panic_puts("\nEXCEPTION ");
    isr_print_dec(frame.vector);
    panic_puts(" err=");
    panic_puthex(frame.errcode);
    panic_putc('\n');
    dump_reg("rax=", frame.rax);
    dump_reg("rbx=", frame.rbx);
    dump_reg("rcx=", frame.rcx);
    dump_reg("rdx=", frame.rdx);
    dump_reg("rsi=", frame.rsi);
    dump_reg("rdi=", frame.rdi);
    dump_reg("rbp=", frame.rbp);
    dump_reg("r8=", frame.r8);
    dump_reg("r9=", frame.r9);
    dump_reg("r10=", frame.r10);
    dump_reg("r11=", frame.r11);
    dump_reg("r12=", frame.r12);
    dump_reg("r13=", frame.r13);
    dump_reg("r14=", frame.r14);
    dump_reg("r15=", frame.r15);
    dump_reg("rip=", frame.rip);
    dump_reg("cs=", frame.cs);
    dump_reg("rflags=", frame.rflags);
    dump_reg("rsp=", frame.rsp);
    dump_reg("ss=", frame.ss);
    asm { "cli" }
    while true {
        asm { "hlt" }
    }
}

fn isr_dispatch_asc(frame: *const ISRFrame) -> void {
    let vec = frame.vector;
    if vec < VECTOR_EXCEPTION_MAX {
        exception_halt(frame);
    }
    if vec == VECTOR_PIT {
        pit_tick();
        pic_send_eoi(vec);
        return;
    }
    if vec == VECTOR_SPURIOUS_MASTER {
        // acknowledging a spurious would desync the PIC's in-service register
        return;
    }
    pic_send_eoi(vec);
}
