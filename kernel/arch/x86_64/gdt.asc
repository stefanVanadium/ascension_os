// kernel/arch/x86_64/gdt.asc: long-mode GDT built at runtime into a static.
//
// User segments land now so PROC consumes real selectors next sprint
// instead of churning this table later. Quads are the canonical flat
// encodings; hardware ignores limits in 64-bit but the conventional forms
// (L=1 code, G=1 data) keep debuggers and QEMU tracing honest. The TSS
// descriptor is the one entry needing runtime data: its base is wherever
// tss.asc parked the TSS bytes, delivered through an accessor because
// statics never cross units as data symbols.

fn tss_base_addr() -> u64;
fn store_u64_le(dst: *volatile u8, off: u64, v: u64) -> void;
fn gdt_flush(gdtr: *const u8) -> void;

const GDT_ENTRY_COUNT: u64 = 7;
const GDT_ENTRY_BYTES: u64 = 8;

const GDT_SEL_KCODE: u16 = 0x08;
const GDT_SEL_KDATA: u16 = 0x10;
const GDT_SEL_UCODE: u16 = 0x18;
const GDT_SEL_UDATA: u16 = 0x20;
const GDT_SEL_TSS: u16 = 0x28;

const GDT_KCODE_QUAD: u64 = 0x00AF9A000000FFFF;
const GDT_KDATA_QUAD: u64 = 0x00CF92000000FFFF;
const GDT_UCODE_QUAD: u64 = 0x002FFA000000FFFF;
const GDT_UDATA_QUAD: u64 = 0x00CFF2000000FFFF;

const GDT_IDX_TSS_LO: u64 = 5;
const GDT_IDX_TSS_HI: u64 = 6;

const TSS_DESC_ACCESS: u64 = 0x89;   // present + type 9: available 64-bit TSS
const TSS_DESC_LIMIT: u64 = 103;     // 104-byte TSS, byte-granular so G=0

const GDT_MASK_8: u64 = 0xFF;
const GDT_MASK_16: u64 = 0xFFFF;

let gdt_table: [GDT_ENTRY_COUNT]u64;

fn gdt_load() -> void {
    gdt_table[0] = 0;
    gdt_table[1] = GDT_KCODE_QUAD;
    gdt_table[2] = GDT_KDATA_QUAD;
    gdt_table[3] = GDT_UCODE_QUAD;
    gdt_table[4] = GDT_UDATA_QUAD;

    let base = tss_base_addr();
    // low half: limit15:0 | base15:0 | base23:16 | access | gran(=0) | base31:24
    gdt_table[GDT_IDX_TSS_LO] =
          (TSS_DESC_LIMIT & GDT_MASK_16)
        | ((base & GDT_MASK_16) << 16)
        | (((base >> 16) & GDT_MASK_8) << 32)
        | (TSS_DESC_ACCESS << 40)
        | (((base >> 24) & GDT_MASK_8) << 56);
    gdt_table[GDT_IDX_TSS_HI] = base >> 32;

    // GDTR by hand: limit word @0, base qword @2
    let gdtr_bytes: [10]u8;
    let limit = (GDT_ENTRY_COUNT * GDT_ENTRY_BYTES) - 1;
    gdtr_bytes[0] = limit as u8;
    gdtr_bytes[1] = (limit >> 8) as u8;
    store_u64_le(&gdtr_bytes[0], 2, &gdt_table[0] as u64);
    gdt_flush(&gdtr_bytes[0]);
}
