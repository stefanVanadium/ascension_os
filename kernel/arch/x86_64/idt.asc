// kernel/arch/x86_64/idt.asc: 256 interrupt gates built at runtime.
//
// Stub addresses come through isr_stub_table_ptr() because ascc has no
// extern data symbols, only functions. Each gate is exactly two u64s (the
// packed 16-byte hardware layout): quad 0 carries offset_lo | selector |
// ist | type_attr | offset_mid, quad 1 carries offset_hi | reserved.
// Vector 8 gets IST1 so a double fault on a wrecked stack lands on dry
// ground in tss.df_stack instead of rebooting the machine.

fn isr_stub_table_ptr() -> *const u64;
fn store_u64_le(dst: *volatile u8, off: u64, v: u64) -> void;
fn idt_flush(idtr: *const u8) -> void;

const IDT_VECTOR_COUNT: u64 = 256;
const IDT_GATE_BYTES: u64 = 16;
const IDT_TOTAL_QUADS: u64 = 512;
const IDT_GATE_QUADS: u64 = 2;

const IDT_SEL_KCODE: u16 = 0x08;
const IDT_TYPE_IRQ64: u64 = 0x8E;     // present, ring 0, 64-bit interrupt gate
const IDT_IST_DF: u64 = 1;
const IDT_VEC_DOUBLE_FAULT: u64 = 8;

const IDT_MASK_16: u64 = 0xFFFF;
const IDT_MASK_32: u64 = 0xFFFFFFFF;

let gates: [IDT_TOTAL_QUADS]u64;

fn idt_load() -> void {
    let stubs = isr_stub_table_ptr();
    let i: u64 = 0;
    while i < IDT_VECTOR_COUNT {
        let entry = stubs[i];
        let q = i * IDT_GATE_QUADS;
        gates[q] =
              (entry & IDT_MASK_16)
            | ((IDT_SEL_KCODE as u64) << 16)
            | (IDT_TYPE_IRQ64 << 40)
            | (((entry >> 16) & IDT_MASK_16) << 48);
        gates[q + 1] = ((entry >> 32) & IDT_MASK_32);
        i = i + 1;
    }
    let dfq = IDT_VEC_DOUBLE_FAULT * IDT_GATE_QUADS;
    gates[dfq] = gates[dfq] | (IDT_IST_DF << 32);

    // IDTR by hand: limit word @0, base qword @2
    let idtr_bytes: [10]u8;
    let limit = (IDT_VECTOR_COUNT * IDT_GATE_BYTES) - 1;
    idtr_bytes[0] = limit as u8;
    idtr_bytes[1] = (limit >> 8) as u8;
    store_u64_le(&idtr_bytes[0], 2, &gates[0] as u64);
    idt_flush(&idtr_bytes[0]);
}
