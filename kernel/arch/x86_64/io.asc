// kernel/arch/x86_64/io.asc: hardware access primitives.
//
// Port I/O is one-instruction asm blocks. The LE-store helpers exist
// because #[packed] does not parse today (the lexer emits `packed` as a
// keyword while the attribute matcher wants an identifier; LANG bug), so
// hardware layouts such as the GDTR/IDTR/TSS are written by hand into u8
// arrays. Accesses are volatile so LLVM cannot fold the byte loops into
// memset/memcpy idioms and recurse into libk/mem.asc.

fn outb(port: u16, val: u8) -> void {
    asm { "outb %0, %1" :: "a"(val), "Nd"(port) }
}

fn outw(port: u16, val: u16) -> void {
    asm { "outw %0, %1" :: "a"(val), "Nd"(port) }
}

fn inb(port: u16) -> u8 {
    let ret: u8;
    asm { "inb %1, %0" : "=a"(ret) : "Nd"(port) }
    return ret;
}

fn inw(port: u16) -> u16 {
    let ret: u16;
    asm { "inw %1, %0" : "=a"(ret) : "Nd"(port) }
    return ret;
}

fn store_u16_le(dst: *volatile u8, off: u64, v: u64) -> void {
    dst[off] = v as u8;
    dst[off + 1] = (v >> 8) as u8;
}

fn store_u32_le(dst: *volatile u8, off: u64, v: u64) -> void {
    dst[off] = v as u8;
    dst[off + 1] = (v >> 8) as u8;
    dst[off + 2] = (v >> 16) as u8;
    dst[off + 3] = (v >> 24) as u8;
}

fn store_u64_le(dst: *volatile u8, off: u64, v: u64) -> void {
    dst[off] = v as u8;
    dst[off + 1] = (v >> 8) as u8;
    dst[off + 2] = (v >> 16) as u8;
    dst[off + 3] = (v >> 24) as u8;
    dst[off + 4] = (v >> 32) as u8;
    dst[off + 5] = (v >> 40) as u8;
    dst[off + 6] = (v >> 48) as u8;
    dst[off + 7] = (v >> 56) as u8;
}
