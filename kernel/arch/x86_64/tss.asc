// kernel/arch/x86_64/tss.asc: TSS plus the two interrupt stacks it aims at.
//
// RSP0 is where ring 3 entries will land (PROC wave); IST1 exists NOW
// because the double-fault gate needs a guaranteed-good stack even when
// RSP itself is what faulted. The stacks live here rather than in idt.asc
// so the wiring between TSS fields and their targets stays inside one unit.
// The 104-byte hardware layout is written through explicit LE stores;
// offsets are from the SDM 64-bit TSS figure (RSP0 @4, then RSP1/RSP2,
// an 8-byte reserved gap, IST1 @0x24=36). Getting IST1's slot wrong reads
// as zero on the first real double fault and triple-faults the handler
// itself, which is the exact failure this stack exists to prevent.

const TSS_OFF_RSP0: u64 = 4;
const TSS_OFF_IST1: u64 = 36;
const TSS_OFF_IOMAP: u64 = 100;    // u16 IOPB offset field

fn store_u16_le(dst: *volatile u8, off: u64, v: u64) -> void;
fn store_u64_le(dst: *volatile u8, off: u64, v: u64) -> void;

const TSS_SIZE_BYTES: u64 = 104;
const TSS_IOMAP_BASE: u64 = 104;   // no permission bitmap: base == size

const INT_STACK_BYTES: u64 = 16384;
const DF_STACK_BYTES: u64 = 4096;
const TSS_SEL: u16 = 0x28;

let tss_bytes: [TSS_SIZE_BYTES]u8;
let int_stack: [INT_STACK_BYTES]u8;
let df_stack: [DF_STACK_BYTES]u8;

// tops are one-past-the-end: stacks grow down from there
fn int_stack_top() -> u64 {
    return ((int_stack as *const u8) as u64) + INT_STACK_BYTES;
}

fn df_stack_top() -> u64 {
    return ((df_stack as *const u8) as u64) + DF_STACK_BYTES;
}

fn tss_base_addr() -> u64 {
    return &tss_bytes[0] as u64;
}

// definition must precede tss_load: ascc mangles a same-unit definition
// that only gets forward-referenced by an earlier call site (emits `.1`)
fn tss_flush() -> void {
    let sel: u16 = TSS_SEL;
    asm { "ltr %ax" :: "{ax}"(sel) : "memory", "cc" }
}

fn tss_load() -> void {
    store_u64_le(&tss_bytes[0], TSS_OFF_RSP0, int_stack_top());
    store_u64_le(&tss_bytes[0], TSS_OFF_IST1, df_stack_top());
    store_u16_le(&tss_bytes[0], TSS_OFF_IOMAP, TSS_IOMAP_BASE);
    tss_flush();
}
