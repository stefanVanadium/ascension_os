// kernel/mm/vmm.asc: page tables, built fresh and then switched in.
//
// vmm_init() constructs a complete new address space WHILE boot.asm's static
// tables still own CR3: every table page comes from pmm_alloc() and is written
// through phys_to_virt(), so the bootstrap window has to cover those frames
// (boot.asm maps the first 4 MiB at 0xFFFF800000000000 for exactly this).
// Only when the walk is complete does CR3 move, and the identity map goes away
// with it: nothing may hold a physical address as a virtual one afterwards.
//
// Layout installed here (post-switch, see docs/MEMORY_MAP.md):
//
//   PML4[256] -> PDPT_WINDOW -> PD -> phys 0 .. top_of_ram as 2 MiB huge
//                pages, RW+NX. The physical window; phys_to_virt becomes real.
//   PML4[511] -> PDPT_HIGH -> PDPT_HIGH[510] -> 4 KiB pages for the binary
//                itself, W^X per section (text R+X, rodata R, data+bss RW,
//                anything past bss stays NX).
//
// Two things stay unmapped on purpose: PML4[511][511] and the 1 MiB gap below
// the binary, so a wild kernel pointer faults instead of landing on whatever
// would have been there. User space gets its own PML4[0..255] entries in the
// PROC wave; until then nothing maps there.
//
// NX only counts once EFER.NXE is set, which vmm_init flips before the CR3
// write. Forgetting that leaves every NX bit a silent no-op.

fn panic_puts(msg: *const u8) -> void;
fn panic_putc(c: u8) -> void;
fn panic_puthex(v: u64) -> void;
fn panic_print_dec(v: u64) -> void;
fn kassert(cond: bool, src: *const u8, line: u64, msg: *const u8) -> void;
fn phys_to_virt(p: Paddr) -> Vaddr;
fn memset(s: *volatile u8, c: i32, n: u64) -> *u8;
fn pmm_alloc() -> Paddr;
fn pmm_top_phys() -> u64;
fn rdmsr(msr: u32) -> u64;
fn wrmsr(msr: u32, val: u64) -> void;
fn kernel_end_virt() -> Vaddr;
fn align_up_page(v: u64) -> u64;
fn align_up_huge(v: u64) -> u64;
fn text_end_virt() -> Vaddr;
fn rodata_end_virt() -> Vaddr;
fn data_end_virt() -> Vaddr;

// ---- mm.asc constants (textual redeclaration until modules exist) ---------
const PAGE_SIZE: u64 = 4096;
const PAGE_SHIFT: u64 = 12;
const HUGE_SIZE: u64 = 0x200000;
const ENTRIES_PER_TABLE: u64 = 512;
const TABLE_BYTES: u64 = ENTRIES_PER_TABLE * 8;

// PTE/PDE flag bits (SDM vol 3 section 4.5)
const PTE_PRESENT: u64 = 1 << 0;
const PTE_WRITE: u64 = 1 << 1;
const PTE_HUGE: u64 = 1 << 7;
const PTE_NX: u64 = 1 << 63;

// an entry is flags + physical address; the two never overlap, so each read
// masks out the half it does not want
const PTE_ADDR_MASK: u64 = 0x000FFFFFFFFFF000;
const PTE_FLAG_MASK: u64 = 0xFFF0000000000FFF;

const PHYS_MEM_BASE: u64 = 0xFFFF800000000000;
const KERNEL_LINK_BASE: u64 = 0xFFFFFFFF80000000;
const KERNEL_TEXT_VIRT: u64 = 0xFFFFFFFF80100000;   // linker.ld: higher half + 1 MiB

// bootstrap paging reaches the window for the first 4 MiB only; a table page
// above that would fault before the switch, so allocation is fenced there
const LOW_MEM_CEILING: u64 = 0x400000;

const MSR_EFER: u32 = 0xC0000080;
const EFER_NXE_BIT: u64 = 1 << 11;

const U64_ALL_ONES: u64 = 0xFFFFFFFFFFFFFFFF;
const PAGE_ALIGN_MASK: u64 = U64_ALL_ONES ^ (PAGE_SIZE - 1);
const HUGE_ALIGN_MASK: u64 = U64_ALL_ONES ^ (HUGE_SIZE - 1);
const ENTRY_INDEX_MASK: u64 = ENTRIES_PER_TABLE - 1;

type Paddr = distinct u64;
type Vaddr = distinct u64;

// ---- state -------------------------------------------------------------------
let pml4_pa: u64;            // root of the address space in CR3 right now
let window_top_phys: u64;    // bytes of physical memory the window covers
let vmm_ready: bool;

// Table entries are packed bitfields (flags + address), not addresses, so they
// travel as u64 and the Paddr/Vaddr discipline does not apply to them.
// entry_ptr() is the single place a physical frame becomes a writable pointer,
// and it always goes through the window.
fn entry_ptr(pa: u64) -> *volatile u64 {
    return u64(phys_to_virt(Paddr(pa))) as *volatile u64;
}

fn entry_get(pa: u64, idx: u64) -> u64 {
    let tbl = entry_ptr(pa);
    return tbl[idx];
}

fn entry_set(pa: u64, idx: u64, val: u64) -> void {
    let tbl = entry_ptr(pa);
    tbl[idx] = val;
}

// Table pages are fresh physical memory, so they arrive holding BIOS or
// previous-boot garbage: zero before a single entry is read out of one.
//
// No ceiling check here on purpose. This is reachable from vmm_map, which is a
// runtime API: after the cr3 switch the window covers all of RAM, and a table
// page is allowed wherever the allocator puts it. The "must be reachable
// through the bootstrap window" rule belongs to vmm_init, which is the phase
// where it is actually true, and it is asserted there.
fn table_new() -> u64 {
    let p = pmm_alloc();
    memset(u64(phys_to_virt(p)) as *volatile u8, 0, TABLE_BYTES);
    return u64(p);
}

// The same, with the pre-switch invariant enforced. Only vmm_init uses this,
// because only there is it true: the tables it builds are written through
// boot.asm's window, which reaches the first 4 MiB and nothing above it.
// First-fit keeps handing out frames down there while the low pool lasts; when
// it runs out, this halts with a message instead of writing a page table entry
// through a window that is not there.
fn table_new_bootstrap() -> u64 {
    let p = table_new();
    kassert(p < LOW_MEM_CEILING, __FILE__, __LINE__,
        "table page above the bootstrap window");
    return p;
}

fn level_index(virt: u64, level: u64) -> u64 {
    if level == 0 {
        return (virt >> 39) & ENTRY_INDEX_MASK;
    } else {
        if level == 1 {
            return (virt >> 30) & ENTRY_INDEX_MASK;
        } else {
            if level == 2 {
                return (virt >> 21) & ENTRY_INDEX_MASK;
            } else {
                return (virt >> 12) & ENTRY_INDEX_MASK;
            }
        }
    }
}

// Walk pml4_pa down to the mapping entry for `virt`, returning the physical
// address of that entry (already indexed). With create=true the missing
// intermediate tables are allocated and linked. Returns 0 when a level is
// absent and create is false, which is how "not mapped" is spelled here: the
// language has no null pointer literal, and a zero frame index is never a real
// table.
//
// The walk stops early on a 2 MiB page: there is no page table behind it, and
// the PD entry is the mapping. Callers therefore get the base of whatever
// granularity the address is mapped at, not a byte address.
fn walk_to_leaf(virt: u64, create: bool) -> u64 {
    let mut_table: u64 = pml4_pa;
    let mut_level: u64 = 0;
    while mut_level < 3 {
        let idx = level_index(virt, mut_level);
        let e = entry_get(mut_table, idx);
        if (e & PTE_PRESENT) == 0 {
            if !create {
                return 0;
            }
            let fresh = table_new();
            entry_set(mut_table, idx, fresh | PTE_PRESENT | PTE_WRITE);
            mut_table = fresh;
        } else {
            if mut_level == 2 && (e & PTE_HUGE) != 0 {
                return mut_table + idx * 8;
            }
            mut_table = e & PTE_ADDR_MASK;
        }
        mut_level = mut_level + 1;
    }
    return mut_table + level_index(virt, 3) * 8;
}

// The leaf entry address, but only when it is actually present. Without this
// check a walk that stops at an existing page table would report every address
// inside that table's range as mapped, including the ones no entry covers.
fn mapping_entry(virt: u64) -> u64 {
    let leaf = walk_to_leaf(virt, false);
    if leaf == 0 {
        return 0;
    }
    let pte = entry_ptr(leaf);
    if (pte[0] & PTE_PRESENT) == 0 {
        return 0;
    }
    return leaf;
}

// ---- runtime API (post-switch) -------------------------------------------------

// 4 KiB mapping. flags are PTE_* bits; PRESENT and the address are added here.
fn vmm_map(phys: Paddr, virt: Vaddr, flags: u64) -> void {
    kassert(vmm_ready, __FILE__, __LINE__, "vmm used before init");
    kassert((u64(phys) & PAGE_ALIGN_MASK) == u64(phys), __FILE__, __LINE__,
        "vmm_map: physical address is not page aligned");
    kassert((u64(virt) & PAGE_ALIGN_MASK) == u64(virt), __FILE__, __LINE__,
        "vmm_map: virtual address is not page aligned");
    let leaf = walk_to_leaf(u64(virt), true);
    kassert(leaf != 0, __FILE__, __LINE__, "vmm_map: page walk found no leaf");
    let pte = entry_ptr(leaf);
    // splitting an existing 2 MiB mapping is not this function's job; the
    // window owns its huge pages and nothing else should land inside one
    kassert((pte[0] & PTE_HUGE) == 0, __FILE__, __LINE__,
        "vmm_map: address sits inside a 2 MiB mapping");
    pte[0] = (u64(phys) & PTE_ADDR_MASK) | (flags & PTE_FLAG_MASK) | PTE_PRESENT;
}

fn vmm_unmap(virt: Vaddr) -> void {
    kassert(vmm_ready, __FILE__, __LINE__, "vmm used before init");
    let leaf = mapping_entry(u64(virt));
    if leaf == 0 {
        return;
    }
    let pte = entry_ptr(leaf);
    kassert((pte[0] & PTE_HUGE) == 0, __FILE__, __LINE__,
        "vmm_unmap: refusing to tear down a 2 MiB mapping");
    pte[0] = 0;
    // CR3 did not move, so the stale TLB entry has to go by hand
    asm { "invlpg (%0)" :: "r"(u64(virt)) : "memory" }
}

// Base of the mapping holding `virt`, at whatever granularity it is mapped:
// a full 4 KiB frame, or the 2 MiB page behind a huge entry. Never a byte
// address; Paddr/Vaddr discipline plus "page base or bust".
fn vmm_get_phys(virt: Vaddr) -> Paddr {
    kassert(vmm_ready, __FILE__, __LINE__, "vmm used before init");
    let leaf = mapping_entry(u64(virt));
    kassert(leaf != 0, __FILE__, __LINE__, "vmm_get_phys: address is not mapped");
    let pte = entry_ptr(leaf);
    return Paddr(pte[0] & PTE_ADDR_MASK);
}

fn vmm_is_mapped(virt: Vaddr) -> bool {
    return mapping_entry(u64(virt)) != 0;
}

fn vmm_top_phys() -> u64 {
    return window_top_phys;
}

// ---- init ---------------------------------------------------------------------

// W^X by section, from where the linker script says each section ends. Ranges
// are half-open, and a page that straddles a section boundary takes the flags of
// the section it starts in: at most a few rodata bytes share an executable
// page, and no writable page ever holds code.
fn map_binary_page(virt: u64) -> void {
    let mut_flags: u64 = PTE_WRITE | PTE_NX;
    if virt < u64(text_end_virt()) {
        mut_flags = 0;
    } else {
        if virt < u64(rodata_end_virt()) {
            mut_flags = PTE_NX;
        } else {
            if virt >= u64(data_end_virt()) {
                mut_flags = PTE_NX;
            }
        }
    }
    // the image runs at a fixed offset from its link base: the one sanctioned
    // va->pa hop, the same conversion symbols.asc does for kernel_end
    vmm_map(Paddr(virt - KERNEL_LINK_BASE), Vaddr(virt), mut_flags);
}

fn cr3_load(pa: u64) -> void {
    asm { "mov %0, %cr3" :: "r"(pa) : "memory" }
}

fn vmm_init() -> void {
    // NXE first: every NX bit written below is meaningless without it
    let efer = rdmsr(MSR_EFER);
    if (efer & EFER_NXE_BIT) == 0 {
        wrmsr(MSR_EFER, efer | EFER_NXE_BIT);
    }

    let root = table_new_bootstrap();
    pml4_pa = root;
    // The guard on the map/unmap API means "the walk has a root", not "CR3
    // already points at it": vmm_init itself maps the binary through these
    // same calls while the bootstrap tables are still live. What makes the
    // space real is the cr3 write at the end.
    vmm_ready = true;

    // physical window: PML4[256] -> PDPT -> PD chain, filled with 2 MiB huge
    // pages up to the top the PMM tracks (already 2 MiB rounded). The window
    // never claims memory the multiboot2 map did not report as available.
    //
    // A single PD holds 512 huge pages = 1 GiB, so a machine with more RAM than
    // that needs a PD per gigabyte under the same PDPT. The bound is the PDPT
    // itself: 512 PDs x 1 GiB = 512 GiB, which is what PML4[256] can address.
    let top = align_up_huge(pmm_top_phys());
    kassert(top <= ENTRIES_PER_TABLE * ENTRIES_PER_TABLE * HUGE_SIZE,
        __FILE__, __LINE__, "window larger than the 512 GiB PML4 slot");
    window_top_phys = top;
    let win_pdpt = table_new_bootstrap();
    entry_set(root, (PHYS_MEM_BASE >> 39) & ENTRY_INDEX_MASK,
        win_pdpt | PTE_PRESENT | PTE_WRITE);
    let mut_pd: u64 = 0;
    while mut_pd * ENTRIES_PER_TABLE * HUGE_SIZE < top {
        let pd = table_new_bootstrap();
        entry_set(win_pdpt, mut_pd, pd | PTE_PRESENT | PTE_WRITE);
        let mut_huge: u64 = 0;
        while mut_huge < ENTRIES_PER_TABLE
                && (mut_pd * ENTRIES_PER_TABLE + mut_huge) * HUGE_SIZE < top {
            let phys = (mut_pd * ENTRIES_PER_TABLE + mut_huge) * HUGE_SIZE;
            entry_set(pd, mut_huge,
                phys | PTE_PRESENT | PTE_WRITE | PTE_HUGE | PTE_NX);
            mut_huge = mut_huge + 1;
        }
        mut_pd = mut_pd + 1;
    }

    // kernel half: PML4[511] -> PDPT_HIGH. PDPT_HIGH[510] and everything below
    // it get created on demand by vmm_map, one PT per 2 MiB of image.
    let high_pdpt = table_new_bootstrap();
    entry_set(root, (KERNEL_LINK_BASE >> 39) & ENTRY_INDEX_MASK,
        high_pdpt | PTE_PRESENT | PTE_WRITE);

    let binary_end = align_up_page(u64(kernel_end_virt()));
    let mut_page: u64 = KERNEL_TEXT_VIRT;
    while mut_page < binary_end {
        map_binary_page(mut_page);
        mut_page = mut_page + PAGE_SIZE;
    }

    cr3_load(root);
}
