// kernel/mm/mm.asc: shared memory constants and frame math.
//
// Every address-space constant the MM subsystem speaks lives here so no
// magic hex leaks into pmm/vmm/heap. Consumers redeclare what they need
// textually (units cannot import until modules land); the declarations
// erase identically in LLVM, same mechanism as the libk types contract.

const PAGE_SIZE: u64 = 4096;
const PAGE_SHIFT: u64 = 12;
const HUGE_SIZE: u64 = 0x200000;          // 2 MiB page (PS bit in a PD entry)
const HUGE_SHIFT: u64 = 21;
const ENTRIES_PER_TABLE: u64 = 512;
const TABLE_BYTES: u64 = ENTRIES_PER_TABLE * 8;

// PTE/PDE flag bits (SDM vol 3, section 4.5)
const PTE_PRESENT: u64 = 1 << 0;
const PTE_WRITE: u64 = 1 << 1;
const PTE_USER: u64 = 1 << 2;
const PTE_HUGE: u64 = 1 << 7;
const PTE_NX: u64 = 1 << 63;

// physical address bits inside a table entry
const PTE_ADDR_MASK: u64 = 0x000FFFFFFFFFF000;

// fixed virtual bases (see docs/MEMORY_MAP.md)
const PHYS_MEM_BASE: u64 = 0xFFFF800000000000;   // phys window, PML4 slot 256
const KERNEL_LINK_BASE: u64 = 0xFFFFFFFF80000000;

// while bootstrap paging holds, only the first 4 MiB are reachable through
// the window; everything MM touches before the cr3 switch must stay below
const LOW_MEM_CEILING: u64 = 0x400000;

// multiboot2 info tags (u32 type @+0, u32 size @+4, next tag 8-aligned)
const MB2_TAG_END: u64 = 0;
const MB2_TAG_MMAP: u64 = 6;
const MB2_MMAP_AVAILABLE: u64 = 1;
const MB2_MMAP_HDR_BYTES: u64 = 16;      // type+size+entry_size+entry_version

// align v up to a power-of-two boundary without a NOT operator (`!` is
// boolean-only in Asc; xor against all-ones is the same thing)
const U64_ALL_ONES: u64 = 0xFFFFFFFFFFFFFFFF;
const PAGE_ALIGN_MASK: u64 = U64_ALL_ONES ^ (PAGE_SIZE - 1);
const HUGE_ALIGN_MASK: u64 = U64_ALL_ONES ^ (HUGE_SIZE - 1);

type Paddr = distinct u64;

fn align_up_page(v: u64) -> u64 {
    return (v + PAGE_SIZE - 1) & PAGE_ALIGN_MASK;
}

fn align_up_huge(v: u64) -> u64 {
    return (v + HUGE_SIZE - 1) & HUGE_ALIGN_MASK;
}
