// kernel/mm/pmm.asc: physical frame allocator, bitmap flavor.
//
// One bit per 4 KiB frame, 1 = used. The bitmap does NOT live in .bss (its
// size depends on how much RAM the multiboot2 map reports); it is carved from
// the first usable region above the kernel image and marked used like any
// other reservation. GRUB's map already counts the kernel image, the info
// structure and modules as "available", so excluding them here is our job,
// not the bootloader's.
//
// Policy: first fit, lowest frame first. That keeps every early allocation
// below LOW_MEM_CEILING, which is exactly what vmm.asc relies on while it
// builds the real page tables through the bootstrap window. Frame 0 is
// reserved forever, so a zero result can never masquerade as a valid frame.
//
// Interrupt safety: bring-up runs with IF=0 and single-CPU, so no lock yet.
// PROC wave revisits this before anything allocates from task context.

fn kpanic(src: *const u8, line: u64, msg: *const u8) -> never;
fn kassert(cond: bool, src: *const u8, line: u64, msg: *const u8) -> void;
fn phys_to_virt(p: Paddr) -> Vaddr;
fn memset(s: *volatile u8, c: i32, n: u64) -> *u8;
fn kernel_end_phys() -> Paddr;
fn align_up_page(v: u64) -> u64;
fn panic_puts(msg: *const u8) -> void;
fn panic_putc(c: u8) -> void;
fn panic_puthex(v: u64) -> void;

// ---- mm.asc constants (textual redeclaration until modules exist) ---------
const PAGE_SIZE: u64 = 4096;
const PAGE_SHIFT: u64 = 12;
const LOW_MEM_CEILING: u64 = 0x400000;
const LEGACY_MEM_TOP: u64 = 0x100000;   // BIOS/VGA/EBDA: never RAM for us

const MB2_TAG_END: u64 = 0;
const MB2_TAG_MMAP: u64 = 6;
const MB2_MMAP_AVAILABLE: u64 = 1;
const MB2_MMAP_HDR_BYTES: u64 = 16;

type Paddr = distinct u64;
type Vaddr = distinct u64;

const U64_ALL_ONES: u64 = 0xFFFFFFFFFFFFFFFF;
const PAGE_ALIGN_MASK: u64 = U64_ALL_ONES ^ (PAGE_SIZE - 1);

// ---- state -----------------------------------------------------------------
let bitmap: *u8;            // window address of the bitmap
let bitmap_frames: u64;     // frames covered (= highest tracked frame + 1)
let bitmap_start_pa: u64;   // physical addr of the bitmap itself
let frames_free: u64;
let pmm_ready: bool;

// ---- little-endian readers for the mb2 info blob ----------------------------
// Byte-wise on purpose: the info structure arrives at an arbitrary 8-aligned
// physical address, so typed pointer reads would buy alignment questions we
// do not want to reason about while bootstrap paging is still active.
fn rd32(base: *const u8, off: u64) -> u64 {
    return (base[off] as u64)
        | ((base[off + 1] as u64) << 8)
        | ((base[off + 2] as u64) << 16)
        | ((base[off + 3] as u64) << 24);
}

fn rd64(base: *const u8, off: u64) -> u64 {
    return rd32(base, off) | (rd32(base, off + 4) << 32);
}

// next tag offset: tags pack on 8-byte boundaries after their declared size
fn next_tag(off: u64, sz: u64) -> u64 {
    return (off + sz + 7) & (U64_ALL_ONES ^ 7);
}

// Offset of the memory map tag inside the info blob, or 0 when GRUB sent no
// map (then the kernel has nothing to work with and pmm_init asserts). One
// locator for the whole unit: three separate tag walks is three chances to
// disagree about where the entries start.
fn find_mmap_tag(mbi: *const u8, total: u64) -> u64 {
    let mut_off: u64 = 8;
    while mut_off < total {
        let ty = rd32(mbi, mut_off);
        if ty == MB2_TAG_END {
            return 0;
        }
        if ty == MB2_TAG_MMAP {
            return mut_off;
        }
        let sz = rd32(mbi, mut_off + 4);
        if sz < 8 {
            return 0;
        }
        mut_off = next_tag(mut_off, sz);
    }
    return 0;
}

fn mmap_entry_size(mbi: *const u8, tag: u64) -> u64 {
    return rd32(mbi, tag + 8);
}

// entry count from the tag's own size: a 24-byte entry is the standard, but
// the field exists precisely because the bootloader may send more, so the walk
// divides by entry_size instead of assuming
fn mmap_entry_count(mbi: *const u8, tag: u64) -> u64 {
    let esz = mmap_entry_size(mbi, tag);
    if esz < 24 {
        return 0;
    }
    let payload = rd32(mbi, tag + 4) - MB2_MMAP_HDR_BYTES;
    return payload / esz;
}

fn mmap_entry_off(tag: u64, esz: u64, i: u64) -> u64 {
    return tag + MB2_MMAP_HDR_BYTES + i * esz;
}

fn mmap_base(mbi: *const u8, off: u64) -> u64 {
    return rd64(mbi, off);
}

fn mmap_len(mbi: *const u8, off: u64) -> u64 {
    return rd64(mbi, off + 8);
}

fn mmap_type(mbi: *const u8, off: u64) -> u64 {
    return rd32(mbi, off + 16);
}

// print-once inventory: QA compares these regions against the QEMU -m size.
// A memory map nobody looked at is a memory map nobody validated. Hex, not
// decimal: it saves a fourth copy of the digit walker, and reading a base
// address in hex is what the rest of the boot log does.
fn pmm_print_inventory(mbi_phys: u64) -> void {
    kassert(mbi_phys < LOW_MEM_CEILING, __FILE__, __LINE__,
        "mbi above bootstrap map: unreachable pre-switch");
    let mbi = u64(phys_to_virt(Paddr(mbi_phys))) as *const u8;
    let total = rd32(mbi, 0);
    let tag = find_mmap_tag(mbi, total);
    kassert(tag != 0, __FILE__, __LINE__, "multiboot2 sent no memory map");
    let esz = mmap_entry_size(mbi, tag);
    let count = mmap_entry_count(mbi, tag);
    panic_puts("MM: mmap regions=");
    panic_puthex(count);
    panic_putc('\n');
    let mut_i: u64 = 0;
    while mut_i < count {
        let e = mmap_entry_off(tag, esz, mut_i);
        panic_puts("MM: mmap base=");
        panic_puthex(mmap_base(mbi, e));
        panic_puts(" len=");
        panic_puthex(mmap_len(mbi, e));
        panic_puts(" type=");
        panic_puthex(mmap_type(mbi, e));
        panic_putc('\n');
        mut_i = mut_i + 1;
    }
}

// highest usable byte in the map; drives both the bitmap size and the frame count
fn scan_top(mbi: *const u8, total: u64) -> u64 {
    let tag = find_mmap_tag(mbi, total);
    if tag == 0 {
        return 0;
    }
    let esz = mmap_entry_size(mbi, tag);
    let count = mmap_entry_count(mbi, tag);
    let mut_top: u64 = 0;
    let mut_i: u64 = 0;
    while mut_i < count {
        let e = mmap_entry_off(tag, esz, mut_i);
        let base = mmap_base(mbi, e);
        let len = mmap_len(mbi, e);
        if mmap_type(mbi, e) == MB2_MMAP_AVAILABLE && base + len > mut_top {
            mut_top = base + len;
        }
        mut_i = mut_i + 1;
    }
    return mut_top;
}

// mark every AVAILABLE region's whole frames as free (bits cleared)
fn open_available(mbi: *const u8, total: u64) -> void {
    let tag = find_mmap_tag(mbi, total);
    if tag == 0 {
        return;
    }
    let esz = mmap_entry_size(mbi, tag);
    let count = mmap_entry_count(mbi, tag);
    let mut_i: u64 = 0;
    while mut_i < count {
        let e = mmap_entry_off(tag, esz, mut_i);
        if mmap_type(mbi, e) == MB2_MMAP_AVAILABLE {
            let base = mmap_base(mbi, e);
            let len = mmap_len(mbi, e);
            let mut_f = align_up_page(base) >> PAGE_SHIFT;
            let end_f = (base + len) >> PAGE_SHIFT;
            while mut_f < end_f {
                bit_clear(mut_f);
                mut_f = mut_f + 1;
            }
        }
        mut_i = mut_i + 1;
    }
}

// first AVAILABLE region able to hold `bytes` at or above kend and clear of
// the mbi blob; returns 0 when nothing fits
fn place_bitmap(mbi: *const u8, total: u64, bytes: u64, kend: u64,
                mbi_lo: u64, mbi_hi: u64) -> u64 {
    let tag = find_mmap_tag(mbi, total);
    if tag == 0 {
        return 0;
    }
    let esz = mmap_entry_size(mbi, tag);
    let count = mmap_entry_count(mbi, tag);
    let mut_i: u64 = 0;
    while mut_i < count {
        let e = mmap_entry_off(tag, esz, mut_i);
        if mmap_type(mbi, e) == MB2_MMAP_AVAILABLE {
            let base = mmap_base(mbi, e);
            let len = mmap_len(mbi, e);
            let mut_cand = align_up_page(base);
            if mut_cand < kend {
                mut_cand = align_up_page(kend);
            }
            // the mbi blob usually shares this region; stay clear of it
            if mut_cand < mbi_hi && mbi_lo < mut_cand + bytes {
                mut_cand = align_up_page(mbi_hi);
            }
            if mut_cand >= kend && mut_cand + bytes <= base + len {
                return mut_cand;
            }
        }
        mut_i = mut_i + 1;
    }
    return 0;
}

// ---- init --------------------------------------------------------------------
fn pmm_init(mbi_phys: u64) -> void {
    kassert(mbi_phys < LOW_MEM_CEILING, __FILE__, __LINE__,
        "mbi above bootstrap map: unreachable pre-switch");
    let mbi = u64(phys_to_virt(Paddr(mbi_phys))) as *const u8;
    let total_size = rd32(mbi, 0);
    let kend = u64(kernel_end_phys());

    let top = scan_top(mbi, total_size);
    kassert(top > kend, __FILE__, __LINE__, "no usable ram above kernel");
    bitmap_frames = top >> PAGE_SHIFT;

    let bytes = (bitmap_frames + 7) / 8;
    let placed = place_bitmap(mbi, total_size, bytes, kend,
        mbi_phys, mbi_phys + total_size);
    kassert(placed != 0, __FILE__, __LINE__, "no room for the pmm bitmap");
    bitmap_start_pa = placed;
    bitmap = u64(phys_to_virt(Paddr(placed))) as *u8;

    // everything used by default, then open the map and close ours back up:
    // this order means the reservations below cannot drift out of sync with
    // the regions GRUB reported
    memset(bitmap, -1 as i32, bytes);
    open_available(mbi, total_size);
    reserve_range(Paddr(0), Paddr(LEGACY_MEM_TOP));
    reserve_range(Paddr(LEGACY_MEM_TOP), kernel_end_phys());
    reserve_range(Paddr(mbi_phys), Paddr(mbi_phys + total_size));
    reserve_range(Paddr(bitmap_start_pa), Paddr(bitmap_start_pa + bytes));

    // recount instead of tracking deltas across passes: boot-time cost only,
    // and the counter cannot drift from the bitmap by construction
    let mut_count: u64 = 0;
    let mut_w: u64 = 0;
    let words = (bitmap_frames + 63) / 64;
    while mut_w < words {
        let mut_b: u64 = 0;
        while mut_b < 64 {
            let idx = mut_w * 64 + mut_b;
            if idx >= bitmap_frames {
                break;
            }
            if !bit_test(idx) {
                mut_count = mut_count + 1;
            }
            mut_b = mut_b + 1;
        }
        mut_w = mut_w + 1;
    }
    frames_free = mut_count;
    pmm_ready = true;
}

// ---- bitmap primitives -------------------------------------------------------
fn bit_test(idx: u64) -> bool {
    let byte: u64 = bitmap[idx >> 3] as u64;
    return ((byte >> (idx & 7)) & 1) == 1;
}

fn bit_set(idx: u64) -> void {
    bitmap[idx >> 3] = bitmap[idx >> 3] | (1 << (idx & 7)) as u8;
}

fn bit_clear(idx: u64) -> void {
    bitmap[idx >> 3] = bitmap[idx >> 3] & ((U64_ALL_ONES ^ (1 << (idx & 7))) as u8);
}

// Mark every frame that overlaps [start, end) used, clamped at the bitmap edge
// so callers can pass raw region ends without pre-checking them against
// tracked RAM.
//
// The end frame is the one CONTAINING end-1, not the one starting at end: a
// reservation that begins and ends inside the same frame owns that frame
// whole. Getting this wrong is not academic. The bitmap is smaller than a page
// at small RAM sizes, so its own reservation collapsed to an empty range, the
// frame stayed free, pmm_alloc handed it out as the PML4, and the page table
// then overwrote the very bitmap bits it was supposed to protect.
fn reserve_range(start: Paddr, end: Paddr) -> void {
    let s = u64(start);
    let mut_e = u64(end);
    if mut_e <= s {
        return;
    }
    let limit = bitmap_frames << PAGE_SHIFT;
    if mut_e > limit {
        mut_e = limit;
    }
    if mut_e <= s {
        return;
    }
    let mut_f = s >> PAGE_SHIFT;
    let end_f = ((mut_e - 1) >> PAGE_SHIFT) + 1;
    while mut_f < end_f {
        bit_set(mut_f);
        mut_f = mut_f + 1;
    }
}

// ---- runtime ------------------------------------------------------------------
fn pmm_alloc() -> Paddr {
    kassert(pmm_ready, __FILE__, __LINE__, "pmm used before init");
    kassert(frames_free > 0, __FILE__, __LINE__, "out of physical frames");
    let mut_w: u64 = 0;
    let words = (bitmap_frames + 63) / 64;
    while mut_w < words {
        let mut_probe: u64 = 0;
        while mut_probe < 64 && mut_w * 64 + mut_probe < bitmap_frames {
            let idx = mut_w * 64 + mut_probe;
            if !bit_test(idx) {
                bit_set(idx);
                frames_free = frames_free - 1;
                return Paddr(idx << PAGE_SHIFT);
            }
            mut_probe = mut_probe + 1;
        }
        mut_w = mut_w + 1;
    }
    kpanic(__FILE__, __LINE__, "pmm bitmap full but counter disagreed");
}

fn pmm_free(p: Paddr) -> void {
    kassert(pmm_ready, __FILE__, __LINE__, "pmm used before init");
    // frame 0 is reserved forever so that a zero result can never pass for a
    // real frame; freeing it would clear that bit and hand the invariant away
    kassert(u64(p) != 0, __FILE__, __LINE__, "free of the null frame");
    kassert((u64(p) & PAGE_ALIGN_MASK) == u64(p), __FILE__, __LINE__,
        "free of a non page-aligned address");
    let f = u64(p) >> PAGE_SHIFT;
    kassert(f < bitmap_frames, __FILE__, __LINE__, "free of untracked frame");
    kassert(bit_test(f), __FILE__, __LINE__, "double free detected");
    bit_clear(f);
    frames_free = frames_free + 1;
}

fn pmm_free_frames() -> u64 {
    return frames_free;
}

// Highest physical byte the map reported as usable, rounded up to a whole
// frame. The physical window maps exactly this much: rounding to 2 MiB is the
// VMM's business, not ours.
fn pmm_top_phys() -> u64 {
    return bitmap_frames << PAGE_SHIFT;
}
