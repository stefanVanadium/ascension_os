// kernel/mm/heap.asc: explicit arenas, bump allocation, on-demand pages.
//
// There is no global heap on purpose (CLAUDE.md: heap allocation is a
// deliberate choice, never a convenience default). A subsystem that needs
// dynamic memory declares an arena over a virtual range it owns and allocs out
// of it; general kmalloc/kfree is deferred to the PROC wave, which is the
// first consumer that actually wants a shared allocator.
//
// Bump only, no free list: arenas are boot- and kernel-lifetime objects, the
// cost of coalescing is not paid by anyone yet, and a bump allocator has
// exactly one failure mode (running off the end) instead of the three a
// free-list has (fragmentation, double free, use after free). arena_reset()
// rewinds for the cases that do need it.
//
// Pages arrive from pmm_alloc() and are mapped into the arena's virtual range
// by vmm_map() as the bump pointer crosses into them, so an arena reserves
// address space, not memory. OOM returns 0: the caller decides, because only
// the caller knows what a failed allocation means for its subsystem.

fn kpanic(src: *const u8, line: u64, msg: *const u8) -> never;
fn kassert(cond: bool, src: *const u8, line: u64, msg: *const u8) -> void;
fn pmm_alloc() -> Paddr;
fn vmm_map(phys: Paddr, virt: Vaddr, flags: u64) -> void;
fn vmm_is_mapped(virt: Vaddr) -> bool;
fn kernel_end_virt() -> Vaddr;
fn align_up_page(v: u64) -> u64;
fn align_up_huge(v: u64) -> u64;

// ---- mm.asc constants (textual redeclaration until modules exist) ---------
const PAGE_SIZE: u64 = 4096;
const PAGE_SHIFT: u64 = 12;
const HUGE_SIZE: u64 = 0x200000;
const PTE_WRITE: u64 = 1 << 1;
const PTE_NX: u64 = 1 << 63;

const U64_ALL_ONES: u64 = 0xFFFFFFFFFFFFFFFF;
const PAGE_ALIGN_MASK: u64 = U64_ALL_ONES ^ (PAGE_SIZE - 1);
const HUGE_ALIGN_MASK: u64 = U64_ALL_ONES ^ (HUGE_SIZE - 1);

// Four is not a taste call: the kernel binary, the stack pools and the future
// userspace loaders are the only expected owners, and a full table is a
// KASSERT rather than a silent 4th arena nobody remembers.
const MAX_ARENAS: u64 = 4;

type Paddr = distinct u64;
type Vaddr = distinct u64;

// ---- state -------------------------------------------------------------------
let a_base: [MAX_ARENAS]u64;    // virtual base, page aligned
let a_limit: [MAX_ARENAS]u64;   // exclusive end of the arena
let a_bump: [MAX_ARENAS]u64;    // next free byte
let a_live: [MAX_ARENAS]bool;

// Returns the arena id, or KPANICs when the request is malformed: a bad
// range is a programming error, not a runtime condition.
fn arena_create(base: Vaddr, size: u64) -> u64 {
    kassert(size >= PAGE_SIZE, __FILE__, __LINE__, "arena smaller than a page");
    let start = align_up_page(u64(base));
    let end = start + size;
    kassert(end >= start, __FILE__, __LINE__, "arena range overflows");
    // arena_alloc skips the map for pages that are already mapped, so an arena
    // laid over the kernel image or over another arena would hand out those
    // pages instead of its own. Catch it at creation, where the caller can
    // still see which range it asked for.
    kassert(!vmm_is_mapped(Vaddr(start)), __FILE__, __LINE__,
        "arena_create: range starts inside a live mapping");
    // overlap against every live arena, checked before any slot is claimed
    let mut_chk: u64 = 0;
    while mut_chk < MAX_ARENAS {
        if a_live[mut_chk] {
            kassert(end <= a_base[mut_chk] || start >= a_limit[mut_chk],
                __FILE__, __LINE__, "arena_create: range overlaps a live arena");
        }
        mut_chk = mut_chk + 1;
    }
    let mut_id: u64 = 0;
    while mut_id < MAX_ARENAS {
        if !a_live[mut_id] {
            a_base[mut_id] = start;
            a_limit[mut_id] = end;
            a_bump[mut_id] = start;
            a_live[mut_id] = true;
            return mut_id;
        }
        mut_id = mut_id + 1;
    }
    kpanic(__FILE__, __LINE__, "arena table full");
}

// Alignment must be a power of two: anything else silently rounds wrong, and
// the caller asking for it is a bug worth hearing about now.
fn align_up_to(v: u64, align: u64) -> u64 {
    kassert(align != 0 && (align & (align - 1)) == 0, __FILE__, __LINE__,
        "arena_alloc: alignment is not a power of two");
    return (v + align - 1) & (U64_ALL_ONES ^ (align - 1));
}

// Vaddr, so a caller cannot mistake an arena address for a physical one without
// unwrapping it first. Vaddr(0) on OOM, never a fabricated pointer: zero is
// not a legal kernel allocation here, and the file header says the caller
// decides what a failed allocation means.
fn arena_alloc(id: u64, align: u64, size: u64) -> Vaddr {
    kassert(id < MAX_ARENAS && a_live[id], __FILE__, __LINE__, "arena_alloc: bad arena");
    if size == 0 {
        return Vaddr(0);
    }
    let start = align_up_to(a_bump[id], align);
    // alignment can push the start past the end on the last bytes of an arena,
    // and the subtraction below would underflow into a valid-looking answer
    if start >= a_limit[id] {
        return Vaddr(0);
    }
    // subtraction, so an oversized request reads as out of room instead of
    // wrapping into a valid-looking range
    if size > a_limit[id] - start {
        return Vaddr(0);
    }
    let end = start + size;

    // map every page the allocation touches, on demand
    let mut_page = start & PAGE_ALIGN_MASK;
    while mut_page < end {
        if !vmm_is_mapped(Vaddr(mut_page)) {
            vmm_map(pmm_alloc(), Vaddr(mut_page), PTE_WRITE | PTE_NX);
        }
        mut_page = mut_page + PAGE_SIZE;
    }

    a_bump[id] = end;
    return Vaddr(start);
}

fn arena_reset(id: u64) -> void {
    kassert(id < MAX_ARENAS && a_live[id], __FILE__, __LINE__, "arena_reset: bad arena");
    a_bump[id] = a_base[id];
}

fn arena_used(id: u64) -> u64 {
    kassert(id < MAX_ARENAS && a_live[id], __FILE__, __LINE__, "arena_used: bad arena");
    return a_bump[id] - a_base[id];
}

fn arena_free_bytes(id: u64) -> u64 {
    kassert(id < MAX_ARENAS && a_live[id], __FILE__, __LINE__, "arena_free_bytes: bad arena");
    return a_limit[id] - a_bump[id];
}

// The kernel's arena: everything above the image, aligned to 2 MiB so it can
// grow into huge-page country later without colliding with the guard gap.
const KERNEL_ARENA_SIZE: u64 = 0x400000;   // 4 MiB of address space

fn kernel_arena_create() -> u64 {
    let base = align_up_huge(u64(kernel_end_virt()));
    return arena_create(Vaddr(base), KERNEL_ARENA_SIZE);
}
