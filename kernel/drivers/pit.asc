// kernel/drivers/pit.asc: scheduler tick. In the kernel by exception
// (CLAUDE.md boundary rule): the scheduler lives in the kernel and its
// heartbeat is latency-critical. ISR discipline: pit_tick only bumps the
// counter, no serial output, no allocation; the idle loop polls pit_ticks.
// Polling the UART inside an IRQ could stall on a busy transmitter.

fn panic_puts(msg: *const u8) -> void;
fn outb(port: u16, val: u8) -> void;

const PIT_CH0_DATA: u16 = 0x40;
const PIT_COMMAND: u16 = 0x43;
const PIT_CMD_CH0_LOHI_MODE3: u8 = 0x36; // channel 0, lo/hi bytes, square wave
const PIT_INPUT_HZ: u64 = 1193182;
const PIT_DEFAULT_HZ: u64 = 100;

const PIT_BYTE_MASK: u64 = 0xFF;

let tick_counter: u64;

fn pit_tick() -> void {
    tick_counter = tick_counter + 1;
}

fn pit_ticks() -> u64 {
    return tick_counter;
}

fn pit_init() -> void {
    let divisor = PIT_INPUT_HZ / PIT_DEFAULT_HZ;
    outb(PIT_COMMAND, PIT_CMD_CH0_LOHI_MODE3);
    outb(PIT_CH0_DATA, (divisor & PIT_BYTE_MASK) as u8);
    outb(PIT_CH0_DATA, ((divisor >> 8) & PIT_BYTE_MASK) as u8);
    panic_puts("PIT: timer programmed\n");
}
