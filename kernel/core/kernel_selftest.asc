// Ascension kernel entry: SELFTEST build.
//
// Same bring-up as kernel.asc (markers abbreviated to stage names), then
// the end-to-end interrupt ABI proof: recognizable constants get planted
// into rax/rbx/rcx through pinned asm inputs, ud2 raises vector 6 with no
// error code, and the serial log must end with EXCEPTION 6 plus a dump
// carrying the planted values before the clean halt. Garbage in any
// planted register means the stub/frame/dispatch path mangled state
// somewhere between the CPU and Asc.

// ---- shared nominal types (textual redeclaration until modules exist) -----
type Paddr = distinct u64;
type Vaddr = distinct u64;

// ---- libk prototypes (resolved by the linker) -----------------------------
fn phys_to_virt(p: Paddr) -> Vaddr;
fn virt_to_phys(v: Vaddr) -> Paddr;
fn kpanic(src: *const u8, line: u64, msg: *const u8) -> never;

// ---- arch bring-up surface -------------------------------------------------
fn gdt_load() -> void;
fn tss_load() -> void;
fn idt_load() -> void;
fn pic_remap() -> void;
fn pic_mask_irq0_only() -> void;
fn pit_init() -> void;
fn pit_ticks() -> u64;

// UART plumbing lives in libk/panic.asc until DRV formalizes serial
fn outb(port: u16, val: u8) -> void;
fn inb(port: u16) -> u8;

// ---- polling UART (same as kernel.asc) -------------------------------------
const COM1_DATA: u16 = 0x3F8;
const COM1_LSR: u16 = 0x3FD;   // Line Status Register (COM1 + 5)
const LSR_TX_EMPTY: u8 = 0x20; // LSR bit 5

fn serial_putc(c: u8) {
    while (inb(COM1_LSR) & LSR_TX_EMPTY) == 0 {
    }
    outb(COM1_DATA, c);
}

fn serial_puts(msg: *const u8) {
    let i: u64 = 0;
    while msg[i] != 0 {
        serial_putc(msg[i]);
        i = i + 1;
    }
}

// ---- boot contract ---------------------------------------------------------
const MB2_BOOT_MAGIC: u64 = 0x36D76289;

const PLANT_RAX: u64 = 0xA1A2A3A4A5A6A7A8;
const PLANT_RBX: u64 = 0xB1B2B3B4B5B6B7B8;
const PLANT_RCX: u64 = 0xC1C2C3C4C5C6C7C8;

let boot_mb_info_slot: u64;

fn boot_mb_info() -> u64 {
    return boot_mb_info_slot;
}

fn enable_interrupts() -> void {
    asm { "sti" }
}

// ---- boot ------------------------------------------------------------------
fn kmain(mb_magic: u64, mb_info: u64) -> never {
    if mb_magic != MB2_BOOT_MAGIC {
        kpanic(__FILE__, __LINE__, "multiboot2 magic bad");
    }
    boot_mb_info_slot = mb_info;

    // Paddr/Vaddr round trip still holds under the new flow
    let p = Paddr(0x100000);
    if u64(virt_to_phys(phys_to_virt(p))) != u64(p) {
        kpanic(__FILE__, __LINE__, "Paddr/Vaddr round trip broke");
    }

    serial_puts("SELFTEST: gdt\n");
    gdt_load();
    serial_puts("SELFTEST: tss\n");
    tss_load();
    serial_puts("SELFTEST: idt\n");
    idt_load();
    serial_puts("SELFTEST: pic\n");
    pic_remap();
    serial_puts("SELFTEST: mask\n");
    pic_mask_irq0_only();
    serial_puts("SELFTEST: pit\n");
    pit_init();
    serial_puts("SELFTEST: irq on\n");
    enable_interrupts();

    // one asm block, three inputs pinned to their physical registers; the
    // empty volatile template keeps the constants resident until the ud2
    serial_puts("SELFTEST: firing ud2 with planted regs\n");
    asm { "" :: "a"(PLANT_RAX), "b"(PLANT_RBX), "c"(PLANT_RCX) }
    asm { "ud2" }

    // unreachable if dispatch works; ud2 not faulting is itself a failure
    while true {
        asm { "cli" }
        asm { "hlt" }
    }
}
