// Ascension kernel entry.
//
// kmain exercises the libk contract end to end: distinct address types,
// spinlocks (nested + IRQ variants), and a passing KASSERT — with serial
// markers between every step so QA can verify order from the log alone.

// ---- shared nominal types (textual redeclaration until modules exist) -----
type Paddr = distinct u64;
type Vaddr = distinct u64;

// ---- libk prototypes (resolved by the linker) -----------------------------
fn phys_to_virt(p: Paddr) -> Vaddr;
fn virt_to_phys(v: Vaddr) -> Paddr;
fn kpanic(src: *const u8, line: u64, msg: *const u8) -> never;
fn kassert(cond: bool, src: *const u8, line: u64, msg: *const u8) -> void;
fn spinlock_init(l: *u32) -> void;
fn spinlock_acquire(l: *u32) -> void;
fn spinlock_release(l: *u32) -> void;
fn spinlock_acquire_irq(l: *u32) -> u64;
fn spinlock_release_irq(l: *u32, flags: u64) -> void;

// UART plumbing lives in libk/panic.asc until DRV formalizes serial
fn outb(port: u16, val: u8) -> void;
fn inb(port: u16) -> u8;

// ---- polling UART (stays here until the DRV wave formalizes serial) -------
const COM1_DATA: u16 = 0x3F8;
const COM1_LSR: u16 = 0x3FD;   // Line Status Register (COM1 + 5)
const LSR_TX_EMPTY: u8 = 0x20; // LSR bit 5

fn serial_putc(c: u8) {
    while (inb(COM1_LSR) & LSR_TX_EMPTY) == 0 {
    }
    outb(COM1_DATA, c);
}

fn serial_puts(msg: *const u8) {
    let i: u64 = 0;
    while msg[i] != 0 {
        serial_putc(msg[i]);
        i = i + 1;
    }
}

fn halt_forever() -> never {
    asm { "cli" }
    while true {
        asm { "hlt" }
    }
}

// ---- boot -----------------------------------------------------------------
fn kmain() -> never {
    // distinct-type round trip through the libk conversions
    let p = Paddr(0x100000);
    let v = phys_to_virt(p);
    let back = virt_to_phys(v);
    if u64(back) != u64(p) {
        kpanic(__FILE__, __LINE__, "Paddr/Vaddr round trip broke");
    }

    let lock_a: u32;
    let lock_b: u32;
    spinlock_init(&lock_a);
    spinlock_init(&lock_b);
    serial_puts("LIBK: locks initialized\n");

    spinlock_acquire(&lock_a);
    spinlock_acquire(&lock_b);
    serial_puts("LIBK: nested acquire ok\n");
    spinlock_release(&lock_b);
    spinlock_release(&lock_a);
    serial_puts("LIBK: nested release ok\n");

    let flags = spinlock_acquire_irq(&lock_a);
    spinlock_release_irq(&lock_a, flags);
    serial_puts("LIBK: irq lock round trip ok\n");

    kassert(true, __FILE__, __LINE__, "sanity");

    serial_puts("Ascension: hello from Asc\n");
    halt_forever();
}
