// Ascension kernel entry.
//
// Wave 1 integration: arch layer comes up in contract order (GDT, TSS,
// IDT, PIC, PIT), interrupts go on LAST, then the idle loop hlt-waits on
// the tick and reports one marker per 100 ticks. spinlock_irq runs under
// live interrupt fire around every counter read; the first pass reports
// whether IF survived acquisition, which is the property that makes the
// variant worth having. mb_info is stored behind a getter now so MM gets
// a fixed handover surface next sprint.

// ---- shared nominal types (textual redeclaration until modules exist) -----
type Paddr = distinct u64;
type Vaddr = distinct u64;

// ---- libk prototypes (resolved by the linker) -----------------------------
fn phys_to_virt(p: Paddr) -> Vaddr;
fn virt_to_phys(v: Vaddr) -> Paddr;
fn kpanic(src: *const u8, line: u64, msg: *const u8) -> never;
fn kassert(cond: bool, src: *const u8, line: u64, msg: *const u8) -> void;
fn spinlock_init(l: *u32) -> void;
fn spinlock_acquire(l: *u32) -> void;
fn spinlock_release(l: *u32) -> void;
fn spinlock_acquire_irq(l: *u32) -> u64;
fn spinlock_release_irq(l: *u32, flags: u64) -> void;

// UART + printing live in libk/panic.asc until DRV formalizes serial; one
// owner for the UART means one printer, not one per unit that needs to talk.
fn panic_puts(msg: *const u8) -> void;
fn panic_putc(c: u8) -> void;
fn panic_print_dec(v: u64) -> void;

// ---- MM bring-up tail (shared with the selftest entry unit) ----------------
fn boot_mm_stages(mbi_phys: u64) -> void;

// ---- arch bring-up surface (kernel/arch/x86_64 + kernel/drivers) ----------
fn gdt_load() -> void;
fn tss_load() -> void;
fn idt_load() -> void;
fn pic_remap() -> void;
fn pic_mask_irq0_only() -> void;
fn pit_init() -> void;
fn pit_ticks() -> u64;

// ---- boot contract ---------------------------------------------------------
const MB2_BOOT_MAGIC: u64 = 0x36D76289;
const RFLAGS_IF: u64 = 0x200;
const TICKS_PER_MARKER: u64 = 100;   // 1 Hz wall time at the 100 Hz default

let tick_lock: u32;

fn enable_interrupts() -> void {
    asm { "sti" }
}

// ---- boot ------------------------------------------------------------------
fn kmain(mb_magic: u64, mb_info: u64) -> never {
    if mb_magic != MB2_BOOT_MAGIC {
        kpanic(__FILE__, __LINE__, "multiboot2 magic bad");
    }
    // libk exercise under the new boot flow; the irq lock variant gets its
    // real test further down, under live interrupts
    let p = Paddr(0x100000);
    let v = phys_to_virt(p);
    let back = virt_to_phys(v);
    if u64(back) != u64(p) {
        kpanic(__FILE__, __LINE__, "Paddr/Vaddr round trip broke");
    }

    let lock_a: u32;
    let lock_b: u32;
    spinlock_init(&lock_a);
    spinlock_init(&lock_b);
    spinlock_init(&tick_lock);

    spinlock_acquire(&lock_a);
    spinlock_acquire(&lock_b);
    spinlock_release(&lock_b);
    spinlock_release(&lock_a);
    panic_puts("LIBK: locks ok\n");

    kassert(true, __FILE__, __LINE__, "sanity");

    // bring-up order per PLAN: markers go BEFORE each step so a hang
    // leaves the failing stage as the last line on the log
    panic_puts("ARCH: gdt\n");
    gdt_load();
    panic_puts("ARCH: tss\n");
    tss_load();
    panic_puts("ARCH: idt\n");
    idt_load();
    panic_puts("ARCH: pic\n");
    pic_remap();
    pic_mask_irq0_only();
    panic_puts("ARCH: pit\n");
    pit_init();

    // MM takes over paging here. Interrupts stay off until the new address
    // space is live and proven, so a fault during the switch is a clean halt
    // with a CR2 in the dump instead of a half-switched system taking ticks.
    boot_mm_stages(mb_info);

    panic_puts("ARCH: irq on\n");
    enable_interrupts();

    let irq_lock_checked = false;
    while true {
        asm { "hlt" }
        let flags = spinlock_acquire_irq(&tick_lock);
        let now = pit_ticks();
        spinlock_release_irq(&tick_lock, flags);
        if !irq_lock_checked {
            if (flags & RFLAGS_IF) != 0 {
                panic_puts("ARCH: irq lock saw IF set\n");
            } else {
                panic_puts("ARCH: BUG irq lock lost IF\n");
            }
            irq_lock_checked = true;
        }
        if (now % TICKS_PER_MARKER) == 0 {
            panic_puts("ARCH: tick ");
            panic_print_dec(now);
            panic_putc('\n');
        }
    }
}
