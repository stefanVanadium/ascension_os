// Ascension kernel entry — Phase 0 proof-of-life.
//
// Prints a banner on COM1 (polling 16550 UART) byte by byte, then halts.
// Everything here goes through ascc's full pipeline: distinct types,
// inline asm blocks, pointer indexing, volatile-free polling loop.

const COM1_DATA: u16 = 0x3F8;
const COM1_LSR: u16 = 0x3FD;   // Line Status Register (COM1 + 5)
const LSR_TX_EMPTY: u8 = 0x20; // LSR bit 5

fn outb(port: u16, val: u8) {
    asm { "outb %0, %1" :: "a"(val), "Nd"(port) }
}

fn inb(port: u16) -> u8 {
    let ret: u8;
    asm { "inb %1, %0" : "=a"(ret) : "Nd"(port) }
    return ret;
}

fn serial_putc(c: u8) {
    while (inb(COM1_LSR) & LSR_TX_EMPTY) == 0 {
    }
    outb(COM1_DATA, c);
}

fn serial_puts(msg: *const u8) {
    let i: u64 = 0;
    while msg[i] != 0 {
        serial_putc(msg[i]);
        i = i + 1;
    }
}

fn halt_forever() -> never {
    asm { "cli" }
    while true {
        asm { "hlt" }
    }
}

fn kmain() -> never {
    serial_puts("Ascension: hello from Asc\n");
    halt_forever();
}
