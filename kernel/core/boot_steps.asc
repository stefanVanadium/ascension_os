// kernel/core/boot_steps.asc: the MM bring-up tail, shared by both entry units.
//
// kernel.asc and kernel_selftest.asc differ in their stage labels and in what
// they do once the kernel is up. Everything from the memory map onward lives
// here, so the selftest walks the exact MM path the real kernel walks instead
// of a parallel copy that can rot behind it.
//
// Interrupts are still off through this whole file. sti is the caller's last
// statement, after the proof steps, so nothing here can be interrupted by a
// subsystem that has not finished coming up.

fn panic_puts(msg: *const u8) -> void;
fn panic_putc(c: u8) -> void;
fn panic_puthex(v: u64) -> void;
fn panic_print_dec(v: u64) -> void;
fn kassert(cond: bool, src: *const u8, line: u64, msg: *const u8) -> void;
fn kpanic(src: *const u8, line: u64, msg: *const u8) -> never;
fn pmm_print_inventory(mbi_phys: u64) -> void;
fn pmm_init(mbi_phys: u64) -> void;
fn pmm_free_frames() -> u64;
fn vmm_init() -> void;
fn vmm_top_phys() -> u64;
fn vmm_get_phys(virt: Vaddr) -> Paddr;
fn kernel_arena_create() -> u64;
fn arena_alloc(id: u64, align: u64, size: u64) -> u64;
fn arena_reset(id: u64) -> void;
fn arena_used(id: u64) -> u64;
fn arena_free_bytes(id: u64) -> u64;
fn memset(s: *volatile u8, c: i32, n: u64) -> *u8;
fn memcmp(a: *const volatile u8, b: *const volatile u8, n: u64) -> i32;

// ---- layout facts shared with the linker script and boot.asm ---------------
const PHYS_MEM_BASE: u64 = 0xFFFF800000000000;
const KERNEL_PHYS_LOAD: u64 = 0x100000;         // GRUB loads the image here
const KERNEL_TEXT_VIRT: u64 = 0xFFFFFFFF80100000;
const PAGE_SIZE: u64 = 4096;
const HUGE_SIZE: u64 = 0x200000;

type Paddr = distinct u64;
type Vaddr = distinct u64;

// The window is a different mapping of the same bytes: reading the image start
// through it and comparing against the direct higher-half read is the only
// proof that the huge pages point where they claim to.
const WINDOW_PROOF_BYTES: u64 = 64;

fn window_proof() -> void {
    let direct = KERNEL_TEXT_VIRT as *const u8;
    let through_window = (PHYS_MEM_BASE + KERNEL_PHYS_LOAD) as *const u8;
    if memcmp(direct, through_window, WINDOW_PROOF_BYTES) != 0 {
        kpanic(__FILE__, __LINE__, "window read does not match the image");
    }
    // the window is mapped in 2 MiB huge pages, so the walk hands back the
    // 2 MiB page base, not the frame the address sits in
    let page_base = KERNEL_PHYS_LOAD - (KERNEL_PHYS_LOAD % HUGE_SIZE);
    let back = u64(vmm_get_phys(Vaddr(PHYS_MEM_BASE + KERNEL_PHYS_LOAD)));
    kassert(back == page_base, __FILE__, __LINE__,
        "window page walk disagrees with the multiboot2 load address");
    panic_puts("MM: window matches image at ");
    panic_puthex(KERNEL_PHYS_LOAD);
    panic_putc('\n');
}

fn fill_pattern(p: *volatile u8, n: u64, seed: u64) -> void {
    let mut_i: u64 = 0;
    while mut_i < n {
        p[mut_i] = ((mut_i * 31 + seed) & 0xFF) as u8;
        mut_i = mut_i + 1;
    }
}

fn pattern_intact(p: *const volatile u8, n: u64, seed: u64) -> bool {
    let mut_i: u64 = 0;
    while mut_i < n {
        if p[mut_i] != ((mut_i * 31 + seed) & 0xFF) as u8 {
            return false;
        }
        mut_i = mut_i + 1;
    }
    return true;
}

// Alloc, fill, verify, then rewind. The second allocation deliberately spans
// three pages so the refill path (pmm_alloc + vmm_map into the arena) runs
// before anything downstream depends on it.
fn arena_smoke() -> void {
    let id = kernel_arena_create();

    let small = arena_alloc(id, 16, 64);
    kassert(small != 0, __FILE__, __LINE__, "arena_alloc returned nothing");
    kassert(small % 16 == 0, __FILE__, __LINE__, "arena_alloc ignored alignment");
    let sp = small as *volatile u8;
    fill_pattern(sp, 64, 7);
    kassert(pattern_intact(sp, 64, 7), __FILE__, __LINE__, "small pattern did not survive");
    kassert(arena_used(id) >= 64, __FILE__, __LINE__, "arena_used undercounts");

    let wide = arena_alloc(id, PAGE_SIZE, PAGE_SIZE * 3);
    kassert(wide != 0, __FILE__, __LINE__, "multi-page arena_alloc returned nothing");
    kassert(wide % PAGE_SIZE == 0, __FILE__, __LINE__, "page-aligned alloc misaligned");
    let wp = wide as *volatile u8;
    fill_pattern(wp, PAGE_SIZE * 3, 19);
    kassert(pattern_intact(wp, PAGE_SIZE * 3, 19), __FILE__, __LINE__,
        "multi-page pattern did not survive");

    // OOM is a clean zero, never a pointer into someone else's arena
    let oom = arena_alloc(id, 16, 1024 * 1024 * 1024);
    kassert(oom == 0, __FILE__, __LINE__, "impossible alloc did not report OOM");

    arena_reset(id);
    kassert(arena_used(id) == 0, __FILE__, __LINE__, "arena_reset left the bump pointer");
    panic_puts("MM: arena ok, free bytes=");
    panic_print_dec(arena_free_bytes(id));
    panic_putc('\n');
}

// Full MM bring-up: map first (look at what the bootloader says before acting
// on it), then the PMM, then the tables, then the proof steps, in that order.
fn boot_mm_stages(mbi_phys: u64) -> void {
    panic_puts("MM: mmap\n");
    pmm_print_inventory(mbi_phys);

    panic_puts("MM: pmm\n");
    pmm_init(mbi_phys);
    panic_puts("MM: free frames=");
    panic_print_dec(pmm_free_frames());
    panic_putc('\n');

    panic_puts("MM: vmm\n");
    vmm_init();
    panic_puts("MM: window top=");
    panic_puthex(vmm_top_phys());
    panic_putc('\n');

    panic_puts("MM: window proof\n");
    window_proof();

    panic_puts("MM: arena\n");
    arena_smoke();
}
