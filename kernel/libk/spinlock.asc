// kernel/libk/spinlock.asc — interrupt-safe spinlocks.
//
// The lock is a single aligned u32 slot (0 = free, 1 = held). Until the
// language has modules, callers own the storage and pass its address; the
// nominal-struct version returns once cross-unit types can be named.
//
// x86 notes:
// - `xchg` asserts LOCK# implicitly — no prefix needed.
// - Templates reference LITERAL registers (%eax/%rdi/%rcx) and the matching
//   explicit constraints pin them ({eax}/{rdi}/{rcx}); this LLVM build
//   mis-substitutes $N operands in memory-reference positions.
// - All asm blocks carry "memory" (+ "cc" where flags change) so LLVM never
//   reorders accesses across a lock operation.

const SPIN_UNLOCKED: u32 = 0;
const SPIN_LOCKED: u32 = 1;

fn spinlock_init(l: *u32) -> void {
    l[0] = SPIN_UNLOCKED;
}

fn spinlock_acquire(l: *u32) -> void {
    let old: u32;
    // atomic test-and-set: swap 1 in, spin while we observe someone else's 1
    asm { "1:\n\txchg %eax, (%rdi)\n\ttest %eax, %eax\n\tjz 2f\n\tpause\n\tjmp 1b\n2:"
          : "=a"(old) : "D"(l) : "memory", "cc" }
}

fn spinlock_release(l: *u32) -> void {
    // $$ = literal AT&T immediate dollar ($ would start an operand reference)
    asm { "movl $$0, (%rdi)" :: "D"(l) : "memory" }
}

// Returns the caller's RFLAGS at acquisition time (IF bit included); pass it
// to spinlock_release_irq to restore the previous interrupt state exactly.
fn spinlock_acquire_irq(l: *u32) -> u64 {
    let flags: u64;
    asm { "pushfq\n\tpopq %rcx" : "=c"(flags) :: "memory", "cc" }
    asm { "cli" ::: "memory", "cc" }
    spinlock_acquire(l);
    return flags;
}

fn spinlock_release_irq(l: *u32, flags: u64) -> void {
    spinlock_release(l);
    asm { "pushq %rcx\n\tpopfq" :: "c"(flags) : "memory", "cc" }
}
