// kernel/libk/symbols.asc: link-time symbol bridge.
//
// PMM needs to know where the kernel image ends in physical memory, but that
// address exists only at link time (`kernel_end = .;` in linker.ld) and ascc
// emits no extern data symbols. Inline asm is the one sanctioned path: the
// AT&T displacement form resolves under LLVM's integrated assembler and leaves
// an undefined `kernel_end` for ld to satisfy (pinned by
// tests/pos/linker_symbol.asc).

type Paddr = distinct u64;
type Vaddr = distinct u64;

// Fixed link base from linker.ld: physical load is 1 MiB, virtual is this
// plus 1 MiB. The subtraction here is the one sanctioned va->pa hop.
const KERNEL_LINK_BASE: u64 = 0xFFFFFFFF80000000;

// Section accessors return the symbol's LINKED VIRTUAL address; converting
// to a physical frame address is the caller's job (subtract KERNEL_LINK_BASE,
// see kernel/mm/vmm.asc). Keeping the conversion at the consumer keeps the
// Paddr/Vaddr discipline visible instead of hidden in this unit.

fn kernel_end_phys() -> Paddr {
    let va: u64;
    asm { "leaq kernel_end(%rip), %0" : "=r"(va) }
    return Paddr(va - KERNEL_LINK_BASE);
}

fn text_end_virt() -> Vaddr {
    let ret: u64;
    asm { "leaq kernel_text_end(%rip), %0" : "=r"(ret) }
    return Vaddr(ret);
}

fn rodata_end_virt() -> Vaddr {
    let ret: u64;
    asm { "leaq kernel_rodata_end(%rip), %0" : "=r"(ret) }
    return Vaddr(ret);
}

fn data_end_virt() -> Vaddr {
    let ret: u64;
    asm { "leaq kernel_data_end(%rip), %0" : "=r"(ret) }
    return Vaddr(ret);
}

fn kernel_end_virt() -> Vaddr {
    let ret: u64;
    asm { "leaq kernel_end(%rip), %0" : "=r"(ret) }
    return Vaddr(ret);
}
