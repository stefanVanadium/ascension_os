// kernel/libk/types.asc — physical vs virtual addresses as distinct types.
//
// Consumers redeclare `Paddr`/`Vaddr` textually in their own unit until the
// language grows modules; the declarations erase identically in LLVM, so the
// linked program agrees (same mechanism as C headers, without header files).

const PHYS_MEM_BASE: u64 = 0xFFFF800000000000;

type Paddr = distinct u64;
type Vaddr = distinct u64;

fn phys_to_virt(p: Paddr) -> Vaddr {
    return Vaddr(u64(p) + PHYS_MEM_BASE);
}

fn virt_to_phys(v: Vaddr) -> Paddr {
    return Paddr(u64(v) - PHYS_MEM_BASE);
}

// NOTE: the PHYS_MEM_BASE window is NOT active yet — paging is static
// (boot.asm, 4 MiB identity + higher-half). These conversions become real
// when MM lands; until then they are the fixed shared contract.
