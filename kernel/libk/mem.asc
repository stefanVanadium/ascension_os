// kernel/libk/mem.asc: freestanding memory routines.
//
// LLVM lowers optimized byte-fill/copy loops into calls to the C runtime
// symbols memset/memcpy/memmove/memcmp; a freestanding kernel must provide
// them. Written in Asc with volatile accesses so the optimizer cannot
// recognize these very loops as memset/memcpy idioms (that would recurse).

fn memset(s: *volatile u8, c: i32, n: u64) -> *u8 {
    let i: u64 = 0;
    while i < n {
        s[i] = c as u8;
        i = i + 1;
    }
    return s as *u8;
}

fn memcpy(d: *volatile u8, s: *const u8, n: u64) -> *u8 {
    let i: u64 = 0;
    while i < n {
        d[i] = s[i];
        i = i + 1;
    }
    return d as *u8;
}

fn memmove(d: *volatile u8, s: *const u8, n: u64) -> *u8 {
    let i: u64 = 0;
    if d as u64 <= s as u64 || s as u64 + n <= d as u64 {
        while i < n {
            d[i] = s[i];
            i = i + 1;
        }
    } else {
        while i < n {
            d[(n - 1) - i] = s[(n - 1) - i];
            i = i + 1;
        }
    }
    return d as *u8;
}

fn memcmp(a: *const volatile u8, b: *const volatile u8, n: u64) -> i32 {
    let i: u64 = 0;
    while i < n {
        if a[i] != b[i] {
            if a[i] < b[i] {
                return -1 as i32;
            }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
