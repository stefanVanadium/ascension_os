// kernel/libk/panic.asc: KPANIC/KASSERT, a descriptive halt that is never silent.
//
// Prints "PANIC <file>:<line>: <msg>" on COM1, then cli+hlt. Panic is
// terminal: panic-during-panic degrades to a double print, never a reboot
// loop or a silent return (the function type is `-> never`).

const COM1_DATA: u16 = 0x3F8;
const COM1_LSR: u16 = 0x3FD;   // Line Status Register (COM1 + 5)
const LSR_TX_EMPTY: u8 = 0x20; // LSR bit 5

// Port primitives moved to kernel/arch/x86_64/io.asc: one home, many
// consumers. These prototypes resolve against it at link time.
fn outb(port: u16, val: u8) -> void;
fn inb(port: u16) -> u8;

fn panic_putc(c: u8) {
    while (inb(COM1_LSR) & LSR_TX_EMPTY) == 0 {
    }
    outb(COM1_DATA, c);
}

fn panic_puts(msg: *const u8) {
    let i: u64 = 0;
    while msg[i] != 0 {
        panic_putc(msg[i]);
        i = i + 1;
    }
}

const HEX_DIGITS: *const u8 = "0123456789abcdef";

const DEC_DIGITS: u64 = 20;   // ceil(log10(2^64)) digits + slack

// One decimal printer for the kernel. Units cannot import each other's
// functions yet, which is how this ended up copied into kernel.asc and
// isr.asc; both now call this one and the copies are gone.
fn panic_print_dec(v: u64) -> void {
    let digits: [DEC_DIGITS]u8;
    let count: u64 = 0;
    let rem = v;
    if rem == 0 {
        panic_putc('0');
        return;
    }
    while rem > 0 {
        digits[count] = '0' + (rem % 10) as u8;
        rem = rem / 10;
        count = count + 1;
    }
    while count > 0 {
        count = count - 1;
        panic_putc(digits[count]);
    }
}

fn panic_puthex(v: u64) {
    let digits: [16]u8;
    let i: u64 = 0;
    let rem = v;
    while i < 16 {
        digits[(15 - i)] = HEX_DIGITS[(rem & 0xF)];
        rem = rem >> 4;
        i = i + 1;
    }
    panic_putc('0');
    panic_putc('x');
    i = 0;
    while i < 16 {
        panic_putc(digits[i]);
        i = i + 1;
    }
}

fn kpanic(src: *const u8, line: u64, msg: *const u8) -> never {
    panic_puts("\nPANIC ");
    panic_puts(src);
    panic_putc(':');
    panic_puthex(line);
    panic_puts(": ");
    panic_puts(msg);
    panic_putc('\n');
    asm { "cli" }
    while true {
        asm { "hlt" }
    }
}

// cond is evaluated eagerly (no macro laziness in v1: documented limitation
// of the function-based API); false means the caller's invariant broke.
fn kassert(cond: bool, src: *const u8, line: u64, msg: *const u8) -> void {
    if !cond {
        kpanic(src, line, msg);
    }
}
